# ─────────────────────────────────────────────────────────────
# Copy to .env.local for local dev; add the same keys in
# Vercel → Project → Settings → Environment Variables for prod.
# Every backend feature is optional and degrades gracefully.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ── stores contact messages + visit counts.
# Tables are created automatically on first request.
DATABASE_URL=

# ── Admin dashboard (/admin) ── any random string, 12+ characters.
ADMIN_TOKEN=

# ── Email: option A — Resend (recommended, server-side) ──
RESEND_API_KEY=
CONTACT_TO_EMAIL=houseinmonzer@proton.me
# Requires a verified domain on Resend; defaults to onboarding@resend.dev
CONTACT_FROM_EMAIL=
# "true" to send visitors an auto-reply (needs a verified domain)
CONTACT_AUTOREPLY=

# ── Email: option B — EmailJS ──
# Used by the browser fallback. The server can use them too if you enable
# "Allow EmailJS API for non-browser applications" in EmailJS → Account → Security.
VITE_EMAILJS_SERVICE=
VITE_EMAILJS_TEMPLATE=
VITE_EMAILJS_KEY=
EMAILJS_PRIVATE_KEY=

# ── Optional WhatsApp ping on new messages (CallMeBot) — server-side only ──
CALLMEBOT_KEY=
CALLMEBOT_PHONE=96181960352

# ── Privacy: salt used to hash visitor IPs for rate limiting ──
IP_HASH_SALT=
